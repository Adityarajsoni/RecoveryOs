# ==========================================
# RecoveryOS Environment Variables Template
# ==========================================

# -----------------
# Backend Config
# -----------------
# 1. Razorpay Configuration (For actual payment links)
# You can get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_here"
RAZORPAY_KEY_SECRET="your_secret_key_here"

# Set to "simulate" for hackathon testing without hitting the real API, 
# or "live" to actually generate payment links.
RAZORPAY_MODE="simulate"

# 2. Google Gemini API (For AI Explanations & Email Drafting)
# Get this from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Server Config
PORT=8000
HOST="0.0.0.0"

# Note for Cloud Deployment (Render, Heroku, etc.)
# FastAPI 0.115+ requires Python 3.11+ for pre-compiled wheels.
PYTHON_VERSION="3.11.0"

# -----------------
# Frontend Config
# -----------------
# (Vite variables must start with VITE_)
VITE_API_BASE_URL="http://localhost:8000/api"
Key / Name: VITE_API_BASE_URL

Value: https://recoveryos-k0eu.onrender.com/api
